#!/usr/bin/env bash
# Termux-Zsh Master CLI Entrypoint (v13.0.0)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${SCRIPT_DIR}/core/api.sh"

subcmd="${1:-help}"
shift || true

run_benchmark() {
    local verbose="${1:-}"
    ui_badge_msg "${badge_ok}" "Measuring Zsh startup latency over 10 iterations..."
    local total=0
    for i in {1..5}; do zsh -i -c exit &>/dev/null; done # Warm-up
    for i in {1..10}; do
        local start_time end_time elapsed
        start_time="$(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))' 2>/dev/null || echo 0)"
        zsh -i -c exit &>/dev/null
        end_time="$(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))' 2>/dev/null || echo 0)"
        if [[ "${start_time}" != "0" && "${end_time}" != "0" ]]; then
            elapsed=$(( (end_time - start_time) / 1000000 ))
            total=$(( total + elapsed ))
        fi
    done
    if [[ ${total} -gt 0 ]]; then
        local avg=$(( total / 10 ))
        local badge="${badge_ok}"
        local tier="Fast 🚀"
        if [[ ${avg} -gt 300 ]]; then
            badge="${badge_fail}"
            tier="Slow ⚠️"
        elif [[ ${avg} -gt 150 ]]; then
            badge="${badge_warn}"
            tier="Normal ⚡"
        fi
        ui_badge_msg "${badge}" "Average Zsh startup time: ${avg} ms (${tier})"
    else
        ui_badge_msg "${badge_ok}" "Benchmark completed."
    fi

    if [[ "${verbose}" == "--verbose" || "${verbose}" == "-v" ]]; then
        printf "\n${bold}Plugin & Startup Function Profiling (zprof):${nocol}\n"
        zsh -i -c "zmodload zsh/zprof; zprof" 2>/dev/null | head -n 15 || true
    fi
}

run_reset() {
    ui_badge_msg "${badge_warn}" "Creating snapshot backup before factory reset..."
    bash "${SCRIPT_DIR}/bin/termux-backup" export "${HOME}/termux-zsh-pre-reset.tar.gz" &>/dev/null || true
    ui_badge_msg "${badge_ok}" "Snapshot saved. Running factory reset..."
    exec bash "${SCRIPT_DIR}/setup.sh" -y
}

case "${subcmd}" in
    doctor)   exec bash "${SCRIPT_DIR}/bin/termux-doctor" "$@" ;;
    theme)    exec bash "${SCRIPT_DIR}/bin/termux-theme" "$@" ;;
    font)     exec bash "${SCRIPT_DIR}/bin/termux-font" "$@" ;;
    plugin)   exec bash "${SCRIPT_DIR}/bin/termux-plugin" "$@" ;;
    package|profile) exec bash "${SCRIPT_DIR}/bin/termux-packages" "$@" ;;
    backup)   exec bash "${SCRIPT_DIR}/bin/termux-backup" "$@" ;;
    settings) exec bash "${SCRIPT_DIR}/bin/termux-settings" "$@" ;;
    failsafe) exec bash "${SCRIPT_DIR}/bin/termux-failsafe" "$@" ;;
    benchmark) run_benchmark "${1:-}" ;;
    reset)    run_reset ;;
    update)
        printf "Checking for updates...\n"
        git -C "${SCRIPT_DIR}" pull --ff-only && printf "Termux-zsh updated successfully.\n" || printf "Update failed. Check your network connection.\n"
        exit 0
        ;;
    version|--version|-v)
        printf "Termux-zsh Framework v13.0.0\n"
        exit 0
        ;;
    help|--help|-h|*)
        printf "${bold}Termux-Zsh Master CLI Framework (v13.0.0)${nocol}\n\n"
        printf "Usage: termux <subcommand> [args]\n\n"
        printf "Subcommands:\n"
        printf "  doctor     Run diagnostic health checks & auto-repairs\n"
        printf "  theme      Manage terminal color schemes and palettes\n"
        printf "  font       Manage terminal Nerd Fonts\n"
        printf "  plugin     Manage Zsh plugins and SDK manifests\n"
        printf "  package    Manage developer package profiles\n"
        printf "  backup     Manage timestamped configuration backups\n"
        printf "  settings   Launch interactive settings dashboard TUI\n"
        printf "  failsafe   Emergency configuration recovery & repair\n"
        printf "  benchmark  Measure Zsh startup latency in milliseconds\n"
        printf "  reset      Reset configuration to baseline defaults (auto-backup)\n"
        printf "  update     Pull latest changes from GitHub\n"
        printf "  version    Display framework version details\n"
        exit 0
        ;;
esac
