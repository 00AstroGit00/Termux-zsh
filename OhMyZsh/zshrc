# Enable Powerlevel10k instant prompt if available. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="${HOME}/.oh-my-zsh"

# Path exports with deduplication
typeset -U path
path=("${HOME}/bin" "${HOME}/.local/bin" "${PREFIX:-/data/data/com.termux/files/usr}/local/bin" "${PREFIX:-/data/data/com.termux/files/usr}/bin" $path)

# Needed to make gpg(2) work
export GPG_TTY="${TTY}"

# Theme configuration
ZSH_THEME="powerlevel10k/powerlevel10k"

# Auto-update settings
zstyle ':omz:update' mode prompt
zstyle ':omz:update' frequency 7

# Command auto-correction
ENABLE_CORRECTION="true"

# Plugins configuration
plugins=(
    alias-finder
    command-not-found
    git
    node
    npm
    zsh-autosuggestions
    zsh-syntax-highlighting
)

# Load OhMyZsh framework
if [[ -f "${ZSH}/oh-my-zsh.sh" ]]; then
    source "${ZSH}/oh-my-zsh.sh"
fi

# Manpage path
export MANPATH="${PREFIX:-/data/data/com.termux/files/usr}/share/man:${MANPATH}"

# >>> termux-zsh initialize >>>
# Preferred editor configuration
export EDITOR="micro"
export VISUAL="micro"
if [[ -n "${SSH_CONNECTION:-}" ]]; then
    export EDITOR="nano"
fi

# Modern CLI Tool Integrations (Opt-in with safe fallbacks)
if command -v eza &>/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias la='eza -a --icons --group-directories-first'
    alias ll='eza -la --icons --group-directories-first'
    alias lt='eza --tree --level=2 --icons'
else
    alias la='ls -A'
    alias ll='ls -la'
fi

if command -v bat &>/dev/null; then
    alias cat='bat --paging=never'
fi

if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

if command -v fzf &>/dev/null; then
    [[ -f "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/key-bindings.zsh" ]] && source "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/key-bindings.zsh"
    [[ -f "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/completion.zsh" ]] && source "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/completion.zsh"
fi

if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

if command -v atuin &>/dev/null; then
    eval "$(atuin init zsh)"
fi

# File Manager & Keybindings Integration
if [[ -f "${HOME}/.config/lf/lfcd.sh" ]]; then
    source "${HOME}/.config/lf/lfcd.sh"
    bindkey -s "^o" "lfcd\n"
fi

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey "^e" edit-command-line
# <<< termux-zsh initialize <<<

# Customize prompt with Powerlevel10k config
[[ ! -f "${HOME}/.p10k.zsh" ]] || source "${HOME}/.p10k.zsh"
