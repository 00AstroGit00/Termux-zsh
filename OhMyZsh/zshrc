# Enable Powerlevel10k instant prompt if available. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="${HOME}/.oh-my-zsh"

# Path exports with deduplication
typeset -U path
path=("${HOME}/bin" "${HOME}/.local/bin" "${PREFIX:-/data/data/com.termux/files/usr}/local/bin" "${PREFIX:-/data/data/com.termux/files/usr}/bin" $path)

# Needed to make gpg(2) work
export GPG_TTY="${TTY}"

# Theme configuration
ZSH_THEME="powerlevel10k/powerlevel10k"

# Auto-update settings
zstyle ':omz:update' mode prompt
zstyle ':omz:update' frequency 7

# Command auto-correction
ENABLE_CORRECTION="true"

# Plugins configuration
plugins=(
    alias-finder
    command-not-found
    git
    node
    npm
    zsh-autosuggestions
    zsh-syntax-highlighting
    fzf-tab
)

# Load OhMyZsh framework
if [[ -f "${ZSH}/oh-my-zsh.sh" ]]; then
    source "${ZSH}/oh-my-zsh.sh"
fi

# Manpage path
export MANPATH="${PREFIX:-/data/data/com.termux/files/usr}/share/man:${MANPATH}"

# >>> termux-zsh initialize >>>
# Preferred editor configuration
export EDITOR="micro"
export VISUAL="micro"
if [[ -n "${SSH_CONNECTION:-}" ]]; then
    export EDITOR="nano"
fi

# Modern CLI Tool Integrations (Opt-in with safe fallbacks)
if command -v eza &>/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias la='eza -a --icons --group-directories-first'
    alias ll='eza -la --icons --group-directories-first'
    alias lt='eza --tree --level=2 --icons'
else
    alias la='ls -A'
    alias ll='ls -la'
fi

if command -v bat &>/dev/null; then
    alias cat='bat --paging=never'
fi

if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

if command -v fzf &>/dev/null; then
    [[ -f "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/key-bindings.zsh" ]] && source "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/key-bindings.zsh"
    [[ -f "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/completion.zsh" ]] && source "${PREFIX:-/data/data/com.termux/files/usr}/share/fzf/completion.zsh"
fi

if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

if command -v atuin &>/dev/null; then
    eval "$(atuin init zsh)"
fi

# File Manager & Keybindings Integration
if [[ -f "${HOME}/.config/lf/lfcd.sh" ]]; then
    source "${HOME}/.config/lf/lfcd.sh"
    bindkey -s "^o" "lfcd\n"
fi

# Long-running command auto-notification hook (>10s)
__cmd_start_time=0
__cmd_name=""

__auto_notify_preexec() {
    __cmd_start_time=${SECONDS}
    __cmd_name="${1:-}"
}

__auto_notify_precmd() {
    if [[ ${__cmd_start_time} -gt 0 ]]; then
        local elapsed=$(( SECONDS - __cmd_start_time ))
        if [[ ${elapsed} -ge 10 ]] && command -v termux-notification &>/dev/null; then
            termux-notification --title "Command Completed (${elapsed}s)" --content "${__cmd_name}" --priority low 2>/dev/null || true
            command -v termux-vibrate &>/dev/null && termux-vibrate -d 100 2>/dev/null || true
        fi
        __cmd_start_time=0
    fi
}
autoload -Uz add-zsh-hook 2>/dev/null || true
add-zsh-hook preexec __auto_notify_preexec 2>/dev/null || true
add-zsh-hook precmd __auto_notify_precmd 2>/dev/null || true

# Custom Powerlevel10k prompt segment for Android battery
prompt_android_battery() {
    if [[ -f /sys/class/power_supply/battery/capacity ]]; then
        local cap="$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo '')"
        local status="$(cat /sys/class/power_supply/battery/status 2>/dev/null || echo '')"
        local icon="🔋"
        [[ "${status}" == "Charging" ]] && icon="⚡"
        if [[ -n "${cap}" ]]; then
            p10k segment -f 7 -t "${icon} ${cap}%"
        fi
    fi
}

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey "^e" edit-command-line
# <<< termux-zsh initialize <<<

# Customize prompt with Powerlevel10k config
[[ ! -f "${HOME}/.p10k.zsh" ]] || source "${HOME}/.p10k.zsh"
